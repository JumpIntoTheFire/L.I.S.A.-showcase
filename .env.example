# LISA environment — copy to .env and fill in. NEVER commit .env.

# === Postgres ===
POSTGRES_USER=lisa_admin
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=local_intelligence_system

# === n8n (UI login) ===
N8N_USER=you@example.com
N8N_PASSWORD=change-me

# === PGAdmin ===
PGADMIN_EMAIL=you@example.com
PGADMIN_PASSWORD=change-me

# === Backend ===
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=generate-a-fresh-64-char-hex-string

ADMIN_USERNAME=jack

# Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
# Escape $ as $$ for Docker Compose (e.g. $2b$12$... becomes $$2b$$12$$...)
ADMIN_PASSWORD_HASH=$$2b$$12$$replace-with-real-bcrypt-hash

# n8n ↔ FastAPI service auth — any long random string
# Generate with: openssl rand -base64 32
N8N_API_KEY=generate-a-fresh-random-string
